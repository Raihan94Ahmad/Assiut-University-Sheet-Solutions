#include<iostream>
using namespace std;
int main(){
    int t;
    cin >> t;
    while(t--){
        int N;
        cin >> N;
        long long A[N];
        for(int i = 0; i< N; i++){
            cin >> A[i];
        }
        for(int i = 0; i<N; i++){
                long long max_value = -1e15;
            for(int j = i; j<N; j++){
                if( A[j]> max_value){
                    max_value = A[j];
                }
            cout<< max_value<< " ";
            }
        }
        cout<< endl;
    }
 return 0;
}
