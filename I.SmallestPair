#include<iostream>
using namespace std;
int main(){
    int t;
    cin >> t;
    while(t--){
    int N;
    cin >> N;
    long long A[N+1];
    for(int i = 1; i<=N; i++){
        cin >> A[i];
    }
    long long temp = 1e9;
   for(int i = 1; i<N; i++){
    for(int j =i+1; j<=N; j++){
        long long total = A[i]+A[j]+j -i;
         if(total < temp){
            temp = total;
         }
    }

   }
   cout<< temp<<endl;
    }

return 0;
}

