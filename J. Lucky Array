    int N;
    cin >> N;
    int A[N];
    for(int i = 0; i<N ; i++){
        cin >> A[i];
    }
    int temp = A[0];
    for(int i = 0; i< N; i++){
    if(temp > A[i]){
        temp = A[i];
    }
    }
    int count = 0;
    for(int i = 0; i<N; i++){
        if(temp == A[i] ){
        count++;
        }
    }
    if(count%2!=0){
            cout<< "Lucky"<<endl;
        }
        else{
            cout<< "Unlucky"<<endl;
        }
return 0;
}
